# Flask application secret key (required)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Google Gemini API key (required)
# 1. Go to https://aistudio.google.com/apikey
# 2. Click "Create API key" (free, no credit card needed)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Rate limiting (all optional) ────────────────────────────────────
# Searches allowed per IP per window, and the window length in seconds.
# Defaults: 10 per 3600s. Set RATE_LIMIT_PER_IP=0 to disable the per-IP limit.
# RATE_LIMIT_PER_IP=10
# RATE_LIMIT_WINDOW_SECONDS=3600

# Ceiling on total searches per day across all visitors, so a distributed
# burst still can't run up the Gemini bill. Default 200; 0 disables it.
# RATE_LIMIT_GLOBAL_PER_DAY=200

# Without these, counters live in each serverless instance's memory, so the
# limits apply per instance rather than globally. Add an Upstash Redis
# database (free tier is plenty) to make them exact.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Set to 0 only if the app is exposed directly rather than behind Vercel,
# where X-Real-IP / X-Forwarded-For can be spoofed by the client.
# TRUST_PROXY_HEADERS=1

# ── Result links (optional) ─────────────────────────────────────────
# How long a result page stays reachable at its /r/<token> URL, and how
# long an identical repeat search reuses it. Default 86400 (24 hours).
# Stored results hold IKEA prices and ratings, which drift over time.
# RESULT_TTL_SECONDS=86400
